{
  "name": "bb-plugin-environment-vercel-sandbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Run BB threads on disposable Vercel Sandbox machines",
  "engines": {
    "bb": ">=0.0",
    "bbPluginSdk": ">=0.4.102"
  },
  "bb": {
    "name": "Vercel Sandbox [Experimental]",
    "description": "Run BB threads on disposable Vercel Sandbox machines",
    "branding": {
      "icon": "./vercel-logo.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ],
    "host": "./host.ts"
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "prepare:bundled": "bb-plugin-build prepare-bundled"
  },
  "dependencies": {
    "@bb/shared-ui": "workspace:*",
    "@vercel/sandbox": "3.5.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@bb/plugin-build": "workspace:*",
    "@get-bb/plugin-sdk": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.1"
  }
}
